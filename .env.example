# Copy this to .env and fill in your actual keys.
# .env is gitignored — never commit the real file.
#
# Usage:
#   ARC/tmux:  sourced automatically by ml/slurm/start_tmux.sh
#   Local:     source .env && export HPEMA_CONFIG=hpema_config.local.yaml && python -m cli.main
#
# All vars must use 'export' so they are visible to child processes.

# vLLM (local) — any non-empty string works
export HPEMA_API_KEY=unused

# External API keys — add whichever providers you use
export NVIDIA_API_KEY=nvapi-...
# export OPENAI_API_KEY=sk-...
# export GROQ_API_KEY=gsk_...

# ChromaDB — suppress noisy telemetry errors
export ANONYMIZED_TELEMETRY=False

# Config file to use (override default hpema_config.yaml)
# Uncomment and set for local API-only runs:
# export HPEMA_CONFIG=hpema_config.local.yaml

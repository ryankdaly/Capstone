# Copy this to .env and fill in your actual keys.
# .env is gitignored — never commit the real file.
#
# Usage: sourced automatically by ml/slurm/start_tmux.sh

# vLLM (local) — any non-empty string works
HPEMA_API_KEY=unused

# External API keys — add whichever providers you use
NVIDIA_API_KEY=nvapi-...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...

# ChromaDB — suppress noisy telemetry errors
ANONYMIZED_TELEMETRY=False
